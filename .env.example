APP_ID=
APP_KEY=
DRIVE_KEYFILE_PATH=
GCP_BUCKET_NAME=
GEMINI_API_KEY=
# Modelo (default: gemini-flash-lite-latest). Los modelos *-lite NO soportan thinking.
GEMINI_MODEL=
# minimal|low|medium|high|off  (default: medium). Usar 'off' en modelos lite (evita 400).
GEMINI_THINKING_LEVEL=
# low|medium|high|ultra_high  (default: high). Sube la resolución que ve el modelo (dígitos chicos).
GEMINI_MEDIA_RESOLUTION=
# Timeout por request en ms (default: 120000). Con thinking medium/high sube la latencia.
GEMINI_TIMEOUT_MS=
# Reintentos SOLO en errores transitorios 503/429 con backoff exponencial (default: 2).
GEMINI_MAX_RETRIES=
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
EMAIL_NAME=
EMAIL_FROM=
EMAIL_TEST_MODE=
EMAIL_TEST_ADDRESS=